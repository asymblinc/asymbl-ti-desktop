RECALLAI_API_URL=https://us-west-2.recall.ai

# The desktop app never holds the Recall API key or any LLM key directly -
# both live only in the control plane (gcp/control-plane in the Recall
# delivery repo). See src/control-plane-client.js.
#
# Default (unset) routes through the MuleSoft CloudHub proxy - see
# docs/mulesoft.md in the Recall repo. Set this to the direct Cloud Run URL
# below to bypass MuleSoft entirely.
# CONTROL_PLANE_URL=https://control-plane-362541775773.us-east1.run.app
